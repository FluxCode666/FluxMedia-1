FROM node:22-slim
WORKDIR /app
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/media-processing-runtime/package.json ./services/media-processing-runtime/package.json
RUN pnpm install --frozen-lockfile --filter @fluxmedia/media-processing-runtime...
COPY services/media-processing-runtime ./services/media-processing-runtime
COPY apps/web/models /models
RUN groupadd --system --gid 1001 runtime && useradd --system --uid 1001 --gid runtime runtime
USER runtime:runtime
ENV MEDIA_PROCESSING_HOST=0.0.0.0
ENV MEDIA_PROCESSING_PORT=8091
ENV MEDIA_PROCESSING_MODELS_PATH=/models
EXPOSE 8091
CMD ["node", "services/media-processing-runtime/server.mjs"]
