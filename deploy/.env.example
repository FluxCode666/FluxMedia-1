# FluxMedia Web 与 Adobe 代理生产环境模板。
# 复制为 deploy/.env 后填写真实值；不要提交包含机密的 .env。

# 镜像由 deploy-production.yml 更新为本次不可变版本。
FLUXMEDIA_IMAGE=ghcr.io/fluxcode666/fluxmedia-web
FLUXMEDIA_MIGRATE_IMAGE=ghcr.io/fluxcode666/fluxmedia-migrate
FLUXMEDIA_PROXY_IMAGE=ghcr.io/fluxcode666/fluxmedia-media-upstream-proxy
FLUXMEDIA_TAG=latest

# web 只绑定宿主机回环地址，由宿主机 Nginx 对外提供 HTTPS。
BIND_HOST=127.0.0.1
WEB_PORT=3001

# 公网域名同时用于前端构建、鉴权回调与可信来源校验。
# 请替换为实际域名；示例文件不包含生产域名。
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=FluxMedia
BETTER_AUTH_URL=https://your-domain.com
BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain.com

# 必填机密。认证密钥可用 openssl rand -base64 32 生成。
DATABASE_URL=
BETTER_AUTH_SECRET=

# 生产迁移备份。S3 配置整体可选；bucket 留空时持久化到部署目录 backups/。
# 本地模式仅是同机恢复点，文件权限为 0600，不能替代异地灾备。
# S3 模式应通过实例角色或下方专用 AWS profile 获得最小权限；age 私钥必须离线保管。
DEPLOY_BACKUP_S3_BUCKET=
DEPLOY_BACKUP_S3_PREFIX=fluxmedia-production
DEPLOY_BACKUP_AGE_RECIPIENT=
DEPLOY_BACKUP_RETENTION_DAYS=7
# 使用实例角色时留空；非实例角色部署只填写目标机已配置的专用 profile 名称。
DEPLOY_BACKUP_AWS_PROFILE=

# 线上使用外部 Redis；密码以独立变量传递，无需 URL 编码。生产必须使用 TLS 或受控内网连接。
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
# Redis ACL 用户名可留空，以使用默认用户。
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_DB=4

# 本地持久化目录位于 Docker 命名卷中。
LOCAL_STORAGE_PATH=/app/storage
# 头像、模型广场与网站品牌可配置为同一私有系统公开资产 bucket；generations 必须独立。
NEXT_PUBLIC_AVATARS_BUCKET_NAME=avatars
NEXT_PUBLIC_GENERATIONS_BUCKET_NAME=generations
MODEL_MARKETPLACE_ASSETS_BUCKET_NAME=model-marketplace
SITE_ASSETS_BUCKET_NAME=site-assets

# 单实例默认启用内部调度器；多实例部署必须重新评估任务互斥策略。
SELF_USE_MODE_ENABLED=true
# 首次自用超管的账号与密码；密码是机密，必须填入高强度值且不得提交。
FLUXMEDIA_SUPER_ADMIN_EMAIL=
FLUXMEDIA_SUPER_ADMIN_PASSWORD=
INTERNAL_JOB_SCHEDULER_ENABLED=true
# APP_TIME_ZONE 是 FluxMedia 的默认展示时区；用户个人时区优先于它。
# 它只控制页面展示，不改变数据库、外部 API 或 Node 进程的 UTC 时间口径。
APP_TIME_ZONE=Asia/Shanghai
# TZ 是 Node 进程运行时区，不是页面展示时区。本项目必须固定为 UTC，因为 pg 会按
# 进程 TZ 解析 timestamp without time zone；设为 Asia/Shanghai 会让北京时间少 8 小时。
TZ=UTC

# Nginx 是唯一可信反向代理，因此允许应用读取其转发的客户端地址头。
RATE_LIMIT_TRUSTED_PROXY=true

# Adobe direct 专用 TLS 代理；secret 必须与 Web 和 sidecar 完全一致。
ADOBE_DIRECT_PROXY_URL=http://media-upstream-proxy:3021
ADOBE_DIRECT_PROXY_SECRET=
ADOBE_DIRECT_PROXY_TIMEOUT_SECONDS=300
ADOBE_DIRECT_PROXY_MAX_BODY_MB=64

# API 上游请求/响应脚本的 QuickJS 资源限制，按每个 Web Node 进程生效。
# Worker 数 1-8；单 Runtime 内存 16-128 MiB；栈 256-2048 KiB。
API_UPSTREAM_SCRIPT_WORKER_COUNT=1
API_UPSTREAM_SCRIPT_MEMORY_LIMIT_MB=32
API_UPSTREAM_SCRIPT_STACK_LIMIT_KB=512

# 可选能力可在后台配置；这里给出安全的最小启动默认值。
PAYMENT_PROVIDER=none
NEXT_PUBLIC_PAYMENT_PROVIDER=none
EMAIL_PROVIDER=
CONTENT_MODERATION_ENABLED=false
CONTENT_MODERATION_PROVIDER=none

# 对象存储、支付、邮件、审核、监控等可选变量见仓库根目录 .env.example。
