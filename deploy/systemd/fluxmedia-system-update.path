# FluxMedia 站内系统更新触发器。
# app 容器把超管请求原子写为 requests/update-request.json 后，systemd 启动同名 service。
# 由 install-system-updater.sh 渲染 @STATE_DIR@ 并安装到 /etc/systemd/system；runner 启动后立即取走请求，
# 因此请求文件不会反复触发。
[Unit]
Description=Watch FluxMedia in-site system update requests

[Path]
PathExists=@STATE_DIR@/requests/update-request.json
Unit=fluxmedia-system-update.service

[Install]
WantedBy=multi-user.target
