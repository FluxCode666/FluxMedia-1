# FluxMedia 站内系统更新执行器（宿主机 root）。
# 由 fluxmedia-system-update.path 触发；@DEPLOY_PATH@/@STATE_DIR@ 由 install-system-updater.sh 渲染。
# 部署包含备份、迁移与健康检查，耗时可能超过数十分钟，故放宽启动超时；
# app 容器重建不影响本宿主机进程。
[Unit]
Description=Apply FluxMedia in-site system update
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=FLUXMEDIA_SYSTEM_UPDATE_STATE_DIR=@STATE_DIR@
ExecStart=/usr/bin/env bash @DEPLOY_PATH@/system-update-runner.sh --deploy-path @DEPLOY_PATH@
TimeoutStartSec=2h
