# Copy to .env before running docker compose.

# Image tags
GPT2IMAGE_ENV_FILE=.env
GPT2IMAGE_IMAGE_TAG=latest

# Public URL
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FluxMedia
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# 用户未设置个人时区时的展示兜底；数据库连接仍固定为 UTC。
APP_TIME_ZONE=Asia/Shanghai

# Database used by docker-compose.yml
POSTGRES_DB=gpt2image
POSTGRES_USER=gpt2image
POSTGRES_PASSWORD=replace-with-a-strong-password

# BullMQ、跨副本生图并发槽与系统设置缓存共用的必填 Redis。
# 本 Compose 内置 Redis 使用明文单节点连接；PostgreSQL 仍保存媒体任务与财务真相。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-with-openssl-rand-hex-32
REDIS_DB=4
REDIS_TLS=false
# 图片与视频使用独立物理队列，并按单个 Web 进程分别限制 Worker 并发。
MEDIA_IMAGE_WORKER_CONCURRENCY=4
MEDIA_VIDEO_WORKER_CONCURRENCY=4

# Local storage inside the web container
LOCAL_STORAGE_PATH=/app/storage
SYSTEM_ASSETS_BUCKET_NAME=system
GENERATIONS_BUCKET_NAME=generations

# Default private deployment mode
SELF_USE_MODE_ENABLED=true
# 首次自用超管的账号与密码；密码是机密，必须替换为空以外的高强度值。
FLUXMEDIA_SUPER_ADMIN_EMAIL=
FLUXMEDIA_SUPER_ADMIN_PASSWORD=
INTERNAL_JOB_SCHEDULER_ENABLED=true

# Adobe direct 专用 TLS 转发 sidecar。secret 为空时代理拒绝启动。
ADOBE_DIRECT_PROXY_URL=http://media-upstream-proxy:3021
ADOBE_DIRECT_PROXY_SECRET=replace-with-openssl-rand-hex-32
ADOBE_DIRECT_PROXY_TIMEOUT_SECONDS=300
ADOBE_DIRECT_PROXY_MAX_BODY_MB=64
# 至少 32 个随机字节；留空时 Adobe 凭据告警 Webhook 显示未配置。
ADOBE_CREDENTIAL_WEBHOOK_HMAC_SECRET=

# Optional payment, mail, moderation and upstream settings can be configured
# in the admin UI after first startup, or added here when you need env fallback.
PAYMENT_PROVIDER=none
NEXT_PUBLIC_PAYMENT_PROVIDER=none
EMAIL_PROVIDER=
CONTENT_MODERATION_ENABLED=false
