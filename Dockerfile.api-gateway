# FluxMedia backend 镜像：Go 原生迁移与 HTTP 服务；保留现有发布维护脚本运行环境。
FROM node:22-slim AS node-base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

FROM node-base AS pruner
WORKDIR /app
RUN pnpm add -g turbo
COPY . .
RUN turbo prune @repo/web --docker

FROM node-base AS migration-deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

FROM migration-deps AS migration-runtime
WORKDIR /app
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
COPY scripts/with-root-env.mjs ./scripts/with-root-env.mjs
ENV NODE_ENV=production

FROM golang:1.26.6-bookworm AS go-builder
WORKDIR /src/services/api-gateway
COPY services/api-gateway/go.mod services/api-gateway/go.sum ./
RUN go mod download
COPY services/api-gateway/*.go ./
COPY services/api-gateway/system_settings_definitions.json ./
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /out/backend .

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
ENV FLUXMEDIA_WEB_ROOT=/app/apps/web
ENV HOME="/home/backend"
ENV COREPACK_HOME="/home/backend/.cache/node/corepack"
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN groupadd --system --gid 1001 backend && \
	useradd --system --create-home --home-dir /home/backend \
		--uid 1001 --gid backend backend && \
	corepack enable && corepack prepare pnpm@10.27.0 --activate && \
	chown -R backend:backend /home/backend
COPY --chown=backend:backend --from=migration-runtime /app ./
COPY --chown=backend:backend --from=go-builder /out/backend /backend
COPY --chown=backend:backend --chmod=0755 services/api-gateway/backend-entrypoint.sh /usr/local/bin/backend-entrypoint
USER backend:backend
RUN /usr/local/bin/backend-entrypoint pnpm --version
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/backend-entrypoint"]
