# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# FluxMedia production image: the Go API with the embedded web SPA, QuickJS and
# media processing share one immutable image while PostgreSQL, Redis and Nginx
# stay external.
FROM node:22-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS node-base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

FROM node-base AS pruner
WORKDIR /app
RUN --mount=type=cache,id=fluxmedia-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm add --global turbo@2.9.18
COPY . .
RUN turbo prune @repo/web --docker --out-dir out/web && \
    turbo prune \
      @fluxmedia/api-upstream-script-runtime \
      @fluxmedia/media-processing-runtime \
      @fluxmedia/unified-runtime \
      --docker --out-dir out/runtime

FROM node-base AS web-deps
WORKDIR /app
COPY --from=pruner /app/out/web/json/ ./
RUN --mount=type=cache,id=fluxmedia-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile

FROM web-deps AS web-builder
WORKDIR /app
COPY --from=pruner /app/out/web/full/ ./
COPY tsconfig.base.json ./tsconfig.base.json
ENV NODE_ENV=production
# Public values are inlined into the SPA bundle and the generated sitemap.
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_NAME=FluxMedia
ARG NEXT_PUBLIC_PAYMENT_PROVIDER=none
ARG NEXT_PUBLIC_GA_ID=
ARG NEXT_PUBLIC_SENTRY_DSN=
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_PAYMENT_PROVIDER=$NEXT_PUBLIC_PAYMENT_PROVIDER
ENV NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
RUN --mount=type=cache,id=fluxmedia-turbo-cache,target=/app/.turbo,sharing=locked \
    pnpm turbo build --filter=@repo/web && \
    test -f apps/web/dist/index.html && \
    find apps/web/dist -name '.DS_Store' -delete

# Production dependencies of the two internal Node services and the release
# commands. The ONNX package ships native binaries for every platform; only the
# Linux x64 binding is loadable in this image.
FROM node-base AS runtime-deps
WORKDIR /app
COPY --from=pruner /app/out/runtime/json/ ./
RUN --mount=type=cache,id=fluxmedia-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --prod --frozen-lockfile
RUN set -eu; \
    onnx_dir="$(find /app/node_modules/.pnpm -type d \
      -path '*/node_modules/onnxruntime-node' -print -quit)"; \
    test -n "${onnx_dir}"; \
    test -r "${onnx_dir}/bin/napi-v6/linux/x64/onnxruntime_binding.node"; \
    test -r "${onnx_dir}/bin/napi-v6/linux/x64/libonnxruntime.so.1"; \
    find "${onnx_dir}/bin/napi-v6" -mindepth 2 -maxdepth 2 -type d \
      ! -path "${onnx_dir}/bin/napi-v6/linux/x64" -exec rm -rf {} +

FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS go-builder
WORKDIR /src/services/api-gateway
COPY services/api-gateway/go.mod services/api-gateway/go.sum ./
RUN --mount=type=cache,id=fluxmedia-go-mod,target=/go/pkg/mod,sharing=locked \
    go mod download
COPY services/api-gateway/*.go ./
COPY services/api-gateway/system_settings_definitions.json ./
COPY services/api-gateway/webui/*.go ./webui/
COPY --from=web-builder /app/apps/web/dist ./webui/dist
RUN --mount=type=cache,id=fluxmedia-go-mod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=fluxmedia-go-build,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go test -tags embed ./webui/ && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -tags embed -trimpath -buildvcs=false -ldflags='-s -w' -o /out/backend .

# platform-fingerprint:begin runner-base
# Everything between the platform-fingerprint markers (plus the files listed in
# deploy/compute-platform-fingerprint.sh) belongs to the image, not to the
# application bundle. Changing it changes the fingerprint, and in-site updates
# refuse releases whose fingerprint differs from the running image.
FROM node:22-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOME=/home/fluxmedia
ENV FLUXMEDIA_WEB_ROOT=/app/apps/web
ENV LOCAL_STORAGE_PATH=/app/storage
ENV SYSTEM_ASSETS_BUCKET_NAME=system
ENV GENERATIONS_BUCKET_NAME=generations
ENV GO_BACKEND_BIND=:8080
ENV GO_BACKEND_URL=http://127.0.0.1:8080
ENV GO_SCRIPT_RUNTIME_URL=http://127.0.0.1:8090
ENV GO_MEDIA_PROCESSING_URL=http://127.0.0.1:8091
ENV SCRIPT_RUNTIME_BIND=:8090
ENV SCRIPT_RUNTIME_HOST=127.0.0.1
ENV MEDIA_PROCESSING_HOST=127.0.0.1
ENV MEDIA_PROCESSING_PORT=8091
ENV MEDIA_PROCESSING_MODELS_PATH=/app/apps/web/models
ENV FLUXMEDIA_IMAGE_ROOT=/app
ENV FLUXMEDIA_RELEASES_DIR=/app/releases

# pg_dump backs up the database before an in-site update; it must match the
# production PostgreSQL major version, which Debian does not ship.
RUN set -eu; \
    groupadd --system --gid 1001 fluxmedia; \
    useradd --system --create-home --home-dir /home/fluxmedia \
      --uid 1001 --gid fluxmedia fluxmedia; \
    apt-get update; \
    apt-get install --yes --no-install-recommends ca-certificates curl; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl --fail --silent --show-error --location \
      --output /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
      https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    . /etc/os-release; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install --yes --no-install-recommends ffmpeg postgresql-client-18; \
    apt-get purge --yes --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*; \
    pg_dump --version | grep -q ' 18\.'
# platform-fingerprint:end runner-base

COPY --link --chown=1001:1001 --from=runtime-deps /app/node_modules ./node_modules
COPY --link --chown=1001:1001 services/api-upstream-script-runtime ./services/api-upstream-script-runtime
COPY --link --chown=1001:1001 --from=runtime-deps /app/services/api-upstream-script-runtime/node_modules ./services/api-upstream-script-runtime/node_modules
COPY --link --chown=1001:1001 services/media-processing-runtime ./services/media-processing-runtime
COPY --link --chown=1001:1001 --from=runtime-deps /app/services/media-processing-runtime/node_modules ./services/media-processing-runtime/node_modules
COPY --link --chown=1001:1001 services/unified-runtime ./services/unified-runtime
COPY --link --chown=1001:1001 --from=runtime-deps /app/services/unified-runtime/node_modules ./services/unified-runtime/node_modules
# Runtime files the backend reads from disk: migrations, blog/docs content,
# pSEO data and the media models.
COPY --link --chown=1001:1001 packages/database/drizzle ./packages/database/drizzle
COPY --link --chown=1001:1001 apps/web/src/content ./apps/web/src/content
COPY --link --chown=1001:1001 apps/web/src/features/pseo/data ./apps/web/src/features/pseo/data
COPY --link --chown=1001:1001 apps/web/models ./apps/web/models
# Release commands run by deploy-release.sh inside the candidate image.
COPY --link --chown=1001:1001 apps/web/scripts/preflight-api-upstream-adapter-migration.mjs ./apps/web/scripts/preflight-api-upstream-adapter-migration.mjs
COPY --link --chown=1001:1001 apps/web/scripts/api-upstream-worker-probe.mjs ./apps/web/scripts/api-upstream-worker-probe.mjs
COPY --link --chown=1001:1001 apps/web/scripts/smoke-api-upstream-worker.mjs ./apps/web/scripts/smoke-api-upstream-worker.mjs
COPY --link --chown=1001:1001 apps/web/src/features/image-backend-pool/api-upstream-script-worker.mjs ./apps/web/src/features/image-backend-pool/api-upstream-script-worker.mjs
COPY --link --chown=1001:1001 apps/web/scripts/backfill-dashboard-analytics.mjs ./apps/web/scripts/backfill-dashboard-analytics.mjs
COPY --link --chown=1001:1001 apps/web/scripts/dashboard-analytics-backfill-core.mjs ./apps/web/scripts/dashboard-analytics-backfill-core.mjs
COPY --link --chown=1001:1001 apps/web/scripts/migrate-video-input-assets.mjs ./apps/web/scripts/migrate-video-input-assets.mjs
COPY --link --chown=1001:1001 apps/web/src/features/image-generation/video-input-migration.ts ./apps/web/src/features/image-generation/video-input-migration.ts
COPY --link --chown=1001:1001 packages/database/scripts/release-governance-gate.mjs ./apps/web/scripts/release-governance-gate.mjs
COPY --link --chown=1001:1001 --from=go-builder /out/backend /backend
COPY --link --chmod=0755 services/unified-runtime/entrypoint.sh /usr/local/bin/fluxmedia-entrypoint

# Release commands under apps/web resolve pg, the S3 client and QuickJS through
# the unified runtime's production dependencies. The link stays relative so the
# same tree works when an in-site update unpacks it under /app/releases.
RUN set -eu; \
    ln -s ../../services/unified-runtime/node_modules /app/apps/web/node_modules; \
    mkdir -p /app/storage /app/releases; \
    chown fluxmedia:fluxmedia /app/storage /app/releases; \
    node --input-type=module -e \
      "await Promise.all([import('./services/api-upstream-script-runtime/server.mjs'),import('./services/media-processing-runtime/server.mjs'),import('./apps/web/scripts/migrate-video-input-assets.mjs'),import('./apps/web/scripts/preflight-api-upstream-adapter-migration.mjs'),import('./apps/web/scripts/backfill-dashboard-analytics.mjs')])"; \
    node --check apps/web/scripts/release-governance-gate.mjs; \
    node -e \
      "(async()=>{const {RuntimePool}=await import('./services/api-upstream-script-runtime/pool.mjs');const pool=new RuntimePool({workerCount:1,memoryLimitBytes:16*1024*1024,stackLimitBytes:512*1024,executionTimeoutMs:5000});await pool.start();try{const output=await pool.execute({kind:'execute',script:'return 1;',stage:'request',inputJson:'null',contextJson:'{}'});if(output!==1)throw new Error('QuickJS self-check failed')}finally{await pool.close(0)}})().catch((error)=>{console.error(error);process.exit(1)})"; \
    node apps/web/scripts/smoke-api-upstream-worker.mjs

# Identity of this build. The in-site updater compares it with GitHub releases
# and only installs bundles built for the same platform fingerprint.
ARG APP_VERSION=0.0.0-dev
ARG GIT_SHA=
ARG PLATFORM_FINGERPRINT=
RUN node -e 'require("node:fs").writeFileSync("/app/release.json", JSON.stringify({version: process.env.APP_VERSION, gitSha: process.env.GIT_SHA, platformFingerprint: process.env.PLATFORM_FINGERPRINT}) + "\n")'

# platform-fingerprint:begin runtime-contract
USER fluxmedia:fluxmedia
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD ["node", "/app/services/unified-runtime/healthcheck.mjs"]
ENTRYPOINT ["/usr/local/bin/fluxmedia-entrypoint"]
# platform-fingerprint:end runtime-contract
