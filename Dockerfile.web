# 基础镜像用 glibc(debian slim)而非 alpine(musl):onnxruntime-node 只有 glibc 预编译,
# musl 上 ISNet 抠图(PSD 导出 / 透明回退)会加载失败;glibc 下 sharp/onnxruntime 预编译均可用。
FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

# --- Prune monorepo for web app ---
FROM base AS pruner
WORKDIR /app
RUN pnpm add -g turbo
COPY . .
RUN turbo prune @repo/web --docker

# --- Install dependencies ---
FROM base AS deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# --- Database migrator ---
FROM deps AS migrator
WORKDIR /app
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
COPY scripts/with-root-env.mjs ./scripts/with-root-env.mjs
ENV NODE_ENV=production
CMD ["pnpm", "--dir", "packages/database", "db:migrate"]

# --- Build ---
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
COPY tsconfig.base.json ./tsconfig.base.json
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_NAME=FluxMedia
ARG NEXT_PUBLIC_PAYMENT_PROVIDER=none
ARG NEXT_PUBLIC_ASSET_PREFIX=
ARG NEXT_PUBLIC_GA_ID=
ARG NEXT_PUBLIC_SENTRY_DSN=
ARG DATABASE_URL=postgresql://gpt2image:gpt2image@localhost:5432/gpt2image
ARG BETTER_AUTH_SECRET=build-time-placeholder-secret-not-for-runtime
ARG BETTER_AUTH_URL=http://localhost:3000
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_PAYMENT_PROVIDER=$NEXT_PUBLIC_PAYMENT_PROVIDER
ENV NEXT_PUBLIC_ASSET_PREFIX=$NEXT_PUBLIC_ASSET_PREFIX
ENV NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV DATABASE_URL=$DATABASE_URL
ENV BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET
ENV BETTER_AUTH_URL=$BETTER_AUTH_URL
RUN pnpm turbo build --filter=@repo/web

# --- Runner ---
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV LOCAL_STORAGE_PATH=/app/storage
ENV SYSTEM_ASSETS_BUCKET_NAME=system
ENV GENERATIONS_BUCKET_NAME=generations
# 当前 runner 只启动一个 Node 主进程；这些值限制该进程内的
# API 上游脚本 Worker Thread Pool，部署环境可在安全范围内覆盖。
ENV API_UPSTREAM_SCRIPT_WORKER_COUNT=1
ENV API_UPSTREAM_SCRIPT_MEMORY_LIMIT_MB=32
ENV API_UPSTREAM_SCRIPT_STACK_LIMIT_KB=512
# ISNet 模型在 standalone 的 apps/web/models 下;容器 cwd=/app(CMD 跑 apps/web/server.js),
# 不显式指定的话 matte.ts 会按 cwd/models 找不到,故指向实际路径。
ENV ISNET_MODEL_PATH=/app/apps/web/models/isnet.onnx

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs nextjs

# 参考媒体在进入上游前需要通过 stdin 做真实时长、尺寸和帧率校验。
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# libonnxruntime.so.1 与 ISNet 模型已由 next.config.mjs 的 outputFileTracingIncludes
# 显式 trace 进 standalone(裸机与 Docker 共用同一机制),无需再从 builder 手工补拷。
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public

RUN mkdir -p /app/storage /app/apps/web/.next/cache && \
    chown -R nextjs:nodejs /app/storage /app/apps/web/.next

USER nextjs
EXPOSE 3000
ENV HOSTNAME="0.0.0.0"
ENV PORT=3000

CMD ["node", "apps/web/server.js"]
